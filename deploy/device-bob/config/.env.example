# Anthropic API key for Claude model access
ANTHROPIC_API_KEY=sk-ant-...

# OpenClaw gateway authentication token
OPENCLAW_GATEWAY_TOKEN=change-me-to-a-secure-random-string

# WhatsApp credentials for Bob's WhatsApp channel
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token

# OpenClaw gateway port (default: 18789)
OPENCLAW_GATEWAY_PORT=18789
