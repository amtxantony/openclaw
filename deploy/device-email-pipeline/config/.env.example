ANTHROPIC_API_KEY=your-anthropic-api-key

# ─────────────────────────────────────────────────────────────
# EMAIL INTAKE METHOD — set ONLY ONE of the four blocks below.
# The agent detects which method to use based on which vars are set.
# ─────────────────────────────────────────────────────────────

# Option A: Gmail REST API (Google OAuth2)
GMAIL_OAUTH_TOKEN_PATH=/workspace/email-intake/tokens/gmail.json
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Option B: Outlook / Microsoft 365 (Microsoft Graph API)
# OUTLOOK_ACCESS_TOKEN_PATH=/workspace/email-intake/tokens/outlook.json
# OUTLOOK_CLIENT_ID=
# OUTLOOK_CLIENT_SECRET=
# OUTLOOK_TENANT_ID=

# Option C: IMAP / SMTP (any provider — Gmail, Outlook, Yahoo, custom)
# IMAP_HOST=imap.gmail.com
# IMAP_USER=
# IMAP_PASSWORD=
# IMAP_PORT=993
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# Option D: Browser automation
# (no env vars needed — requires browser.enabled=true in openclaw.json
#  and the inbox already logged in under the configured browser profile)

# ─────────────────────────────────────────────────────────────
# CRM and ticketing integrations
# ─────────────────────────────────────────────────────────────
HUBSPOT_API_KEY=
LINEAR_API_KEY=

# ─────────────────────────────────────────────────────────────
# Tasksmatic logistics API
# ─────────────────────────────────────────────────────────────
TASKSMATIC_API_URL=https://api.tasksmatic.com
TASKSMATIC_API_KEY=
