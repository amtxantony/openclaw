# Anthropic API key for Claude model access
ANTHROPIC_API_KEY=sk-ant-...

# OpenClaw gateway authentication token
OPENCLAW_GATEWAY_TOKEN=change-me-to-a-secure-random-string

# OpenClaw gateway port (default: 18789)
OPENCLAW_GATEWAY_PORT=18789

# Gateway URLs for sub-agent devices (used by orchestration skill)
ALICE_GATEWAY_URL=http://device-alice:18789
BOB_GATEWAY_URL=http://device-bob:18789
